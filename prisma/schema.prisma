generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

model data_isr {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  no_isr               String                 @db.VarChar(255)
  tanggal              DateTime               @db.Date
  location_id          BigInt                 @db.UnsignedBigInt
  created_at           DateTime?              @db.Timestamp(0)
  updated_at           DateTime?              @db.Timestamp(0)
  locations            locations              @relation(fields: [location_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "data_isr_location_id_foreign")
  pengukuran           pengukuran[]
  pengukuran_frekuensi pengukuran_frekuensi[]

  @@index([location_id], map: "data_isr_location_id_foreign")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model gangguan {
  id              BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  location_id     BigInt                  @db.UnsignedBigInt
  user_id         BigInt?                 @db.UnsignedBigInt
  waktu_kejadian  DateTime                @db.DateTime(0)
  jenis_gangguan  String                  @db.VarChar(255)
  severity        gangguan_severity
  nama_client     String                  @db.VarChar(255)
  frekuensi       Decimal                 @db.Decimal(12, 4)
  band_frekuensi  gangguan_band_frekuensi
  service         gangguan_service
  sub_service     String                  @db.VarChar(255)
  sifat_gangguan  String                  @db.VarChar(255)
  uraian_gangguan String                  @db.Text
  latitude        Decimal                 @db.Decimal(10, 7)
  longitude       Decimal                 @db.Decimal(10, 7)
  kecamatan       String                  @db.VarChar(255)
  no_st           String                  @db.VarChar(255)
  vic             String                  @db.VarChar(255)
  no_laporan      String                  @unique(map: "gangguan_no_laporan_unique") @db.VarChar(255)
  file_path       String?                 @db.VarChar(255)
  status          gangguan_status         @default(pending)
  resolved_at     DateTime?               @db.DateTime(0)
  created_at      DateTime?               @db.Timestamp(0)
  updated_at      DateTime?               @db.Timestamp(0)
  locations       locations               @relation(fields: [location_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "gangguan_location_id_foreign")
  users           users?                  @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "gangguan_user_id_foreign")
  pengganggu      pengganggu[]

  @@index([location_id], map: "gangguan_location_id_foreign")
  @@index([user_id], map: "gangguan_user_id_foreign")
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String  @db.LongText
  options        String? @db.MediumText
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String @db.VarChar(255)
  payload      String @db.LongText
  attempts     Int    @db.UnsignedTinyInt
  reserved_at  Int?   @db.UnsignedInt
  available_at Int    @db.UnsignedInt
  created_at   Int    @db.UnsignedInt

  @@index([queue], map: "jobs_queue_index")
}

model kabupaten {
  id           BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  kab          kabupaten_kab @unique(map: "kabupaten_kab_unique")
  latitude     Decimal?      @db.Decimal(10, 7)
  longitude    Decimal?      @db.Decimal(10, 7)
  kode_wilayah String?       @db.VarChar(255)
  created_at   DateTime?     @db.Timestamp(0)
  updated_at   DateTime?     @db.Timestamp(0)
  monitoring   monitoring[]
}

model locations {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  kota                 String                 @unique(map: "locations_kota_unique") @db.VarChar(255)
  provinsi             String?                @db.VarChar(255)
  latitude             Decimal?               @db.Decimal(10, 7)
  longitude            Decimal?               @db.Decimal(10, 7)
  kode_wilayah         String?                @db.VarChar(255)
  created_at           DateTime?              @db.Timestamp(0)
  updated_at           DateTime?              @db.Timestamp(0)
  data_isr             data_isr[]
  gangguan             gangguan[]
  lokasi_pemancar      lokasi_pemancar[]
  pengganggu           pengganggu[]
  pengukuran           pengukuran[]
  pengukuran_frekuensi pengukuran_frekuensi[]
  stasiun_radio        stasiun_radio[]
}

model lokasi_pemancar {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  latitude             Decimal                @db.Decimal(10, 7)
  longitude            Decimal                @db.Decimal(10, 7)
  alamat               String                 @db.Text
  kelurahan            String?                @db.VarChar(255)
  kecamatan            String?                @db.VarChar(255)
  telp_fax             String?                @db.VarChar(255)
  tinggi_lokasi_mdpl   Decimal?               @db.Decimal(8, 2)
  tinggi_gedung_m      Decimal?               @db.Decimal(8, 2)
  tinggi_menara_m      Decimal?               @db.Decimal(8, 2)
  location_id          BigInt                 @db.UnsignedBigInt
  created_at           DateTime?              @db.Timestamp(0)
  updated_at           DateTime?              @db.Timestamp(0)
  locations            locations              @relation(fields: [location_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "lokasi_pemancar_location_id_foreign")
  pengukuran           pengukuran[]
  pengukuran_frekuensi pengukuran_frekuensi[]

  @@index([location_id], map: "lokasi_pemancar_location_id_foreign")
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int
}

model monitoring {
  id                     BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  upt                    String?    @db.VarChar(255)
  stasiun_monitor        String?    @db.VarChar(255)
  kabupaten_id           BigInt?    @db.UnsignedBigInt
  tanggal                DateTime   @db.Date
  kab_kota               String?    @db.VarChar(255)
  alamat                 String?    @db.VarChar(255)
  lat                    Decimal?   @db.Decimal(10, 7)
  lng                    Decimal?   @db.Decimal(10, 7)
  no_spt                 String?    @db.VarChar(255)
  isrmon_jumlah_isr      Int?
  isrmon_target          Int?
  isrmon_termonitor      Int?
  isrmon_capaian         Decimal?   @db.Decimal(5, 2)
  target_pita            String?    @db.VarChar(255)
  occ_target_pita        String?    @db.VarChar(255)
  occ_capaian            Decimal?   @db.Decimal(5, 2)
  iden_jumlah_termonitor Int?
  iden_target            Int?
  iden_teridentifikasi   Int?
  iden_capaian           Decimal?   @db.Decimal(5, 2)
  capaian_pk_obs         Decimal?   @db.Decimal(5, 2)
  catatan                String?    @db.Text
  created_at             DateTime?  @db.Timestamp(0)
  updated_at             DateTime?  @db.Timestamp(0)
  kabupaten              kabupaten? @relation(fields: [kabupaten_id], references: [id], onUpdate: Restrict, map: "monitoring_kabupaten_id_foreign")

  @@index([kabupaten_id], map: "monitoring_kabupaten_id_foreign")
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model pengganggu {
  id                 BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  gangguan_id        BigInt     @db.UnsignedBigInt
  nama               String     @db.VarChar(255)
  jenis_organisasi   String     @db.VarChar(255)
  kontak             String?    @db.VarChar(255)
  frekuensi          Decimal?   @db.Decimal(8, 4)
  band_frekuensi     String?    @db.VarChar(255)
  status_pelanggaran String?    @db.VarChar(255)
  service            String?    @db.VarChar(255)
  sub_service        String?    @db.VarChar(255)
  kecamatan          String?    @db.VarChar(255)
  latitude           Decimal?   @db.Decimal(10, 7)
  longitude          Decimal?   @db.Decimal(10, 7)
  location_id        BigInt?    @db.UnsignedBigInt
  jalan              String?    @db.VarChar(255)
  alamat_lengkap     String?    @db.Text
  created_at         DateTime?  @db.Timestamp(0)
  updated_at         DateTime?  @db.Timestamp(0)
  gangguan           gangguan   @relation(fields: [gangguan_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "pengganggu_gangguan_id_foreign")
  locations          locations? @relation(fields: [location_id], references: [id], onUpdate: Restrict, map: "pengganggu_location_id_foreign")

  @@index([gangguan_id], map: "pengganggu_gangguan_id_foreign")
  @@index([location_id], map: "pengganggu_location_id_foreign")
}

model pengukuran {
  id                      BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  data_isr_id             BigInt?               @db.UnsignedBigInt
  stasiun_radio_id        BigInt?               @db.UnsignedBigInt
  lokasi_pemancar_id      BigInt?               @db.UnsignedBigInt
  perangkat_pemancar_id   BigInt?               @db.UnsignedBigInt
  pengukuran_frekuensi_id BigInt?               @db.UnsignedBigInt
  pengukuran_studio_id    BigInt?               @db.UnsignedBigInt
  tanggal_pengukuran      DateTime?             @db.Date
  location_id             BigInt?               @db.UnsignedBigInt
  created_at              DateTime?             @db.Timestamp(0)
  updated_at              DateTime?             @db.Timestamp(0)
  data_isr                data_isr?             @relation(fields: [data_isr_id], references: [id], onUpdate: Restrict, map: "pengukuran_data_isr_id_foreign")
  locations               locations?            @relation(fields: [location_id], references: [id], onUpdate: Restrict, map: "pengukuran_location_id_foreign")
  lokasi_pemancar         lokasi_pemancar?      @relation(fields: [lokasi_pemancar_id], references: [id], onUpdate: Restrict, map: "pengukuran_lokasi_pemancar_id_foreign")
  pengukuran_frekuensi    pengukuran_frekuensi? @relation(fields: [pengukuran_frekuensi_id], references: [id], onUpdate: Restrict, map: "pengukuran_pengukuran_frekuensi_id_foreign")
  pengukuran_studio       pengukuran_studio?    @relation(fields: [pengukuran_studio_id], references: [id], onUpdate: Restrict, map: "pengukuran_pengukuran_studio_id_foreign")
  perangkat_pemancar      perangkat_pemancar?   @relation(fields: [perangkat_pemancar_id], references: [id], onUpdate: Restrict, map: "pengukuran_perangkat_pemancar_id_foreign")
  stasiun_radio           stasiun_radio?        @relation(fields: [stasiun_radio_id], references: [id], onUpdate: Restrict, map: "pengukuran_stasiun_radio_id_foreign")

  @@index([data_isr_id], map: "pengukuran_data_isr_id_foreign")
  @@index([location_id], map: "pengukuran_location_id_foreign")
  @@index([lokasi_pemancar_id], map: "pengukuran_lokasi_pemancar_id_foreign")
  @@index([pengukuran_frekuensi_id], map: "pengukuran_pengukuran_frekuensi_id_foreign")
  @@index([pengukuran_studio_id], map: "pengukuran_pengukuran_studio_id_foreign")
  @@index([perangkat_pemancar_id], map: "pengukuran_perangkat_pemancar_id_foreign")
  @@index([stasiun_radio_id], map: "pengukuran_stasiun_radio_id_foreign")
}

model pengukuran_frekuensi {
  id                         BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  kanal                      Int
  frekuensi_terukur_mhz      Decimal             @db.Decimal(8, 4)
  level_dbm                  Decimal             @db.Decimal(8, 4)
  bandwidth_khz              Decimal?            @db.Decimal(8, 4)
  field_strength_dbuvm       Decimal?            @db.Decimal(8, 4)
  deviasi_frekuensi_khz      Decimal?            @db.Decimal(8, 4)
  kedalaman_modulasi_percent Int?
  output_power_tx            Decimal?            @db.Decimal(8, 4)
  cable_loss                 Decimal?            @db.Decimal(8, 4)
  frekuensi_h1_mhz           Decimal?            @db.Decimal(8, 4)
  level_h1_dbm               Decimal?            @db.Decimal(8, 4)
  frekuensi_h2_mhz           Decimal?            @db.Decimal(8, 4)
  level_h2_dbm               Decimal?            @db.Decimal(8, 4)
  frekuensi_h3_mhz           Decimal?            @db.Decimal(8, 4)
  level_h3_dbm               Decimal?            @db.Decimal(8, 4)
  latitude                   Decimal             @db.Decimal(10, 7)
  longitude                  Decimal             @db.Decimal(10, 7)
  alamat                     String              @db.Text
  data_isr_id                BigInt?             @db.UnsignedBigInt
  stasiun_radio_id           BigInt?             @db.UnsignedBigInt
  lokasi_pemancar_id         BigInt?             @db.UnsignedBigInt
  perangkat_pemancar_id      BigInt?             @db.UnsignedBigInt
  pengukuran_studio_id       BigInt?             @db.UnsignedBigInt
  status_hasil               String?             @db.VarChar(255)
  kesimpulan                 String?             @db.Text
  catatan                    String?             @db.Text
  rekomendasi                String?             @db.Text
  nama_petugas               String?             @db.VarChar(255)
  nip_petugas                String?             @db.VarChar(255)
  tanggal_pengukuran         DateTime?           @db.Date
  foto_pengukuran            String?             @db.LongText
  dokumen_pendukung          String?             @db.LongText
  location_id                BigInt?             @db.UnsignedBigInt
  spurious_penerbangan       String?             @db.VarChar(255)
  level_spurious             Decimal?            @db.Decimal(8, 4)
  created_at                 DateTime?           @db.Timestamp(0)
  updated_at                 DateTime?           @db.Timestamp(0)
  pengukuran                 pengukuran[]
  data_isr                   data_isr?           @relation(fields: [data_isr_id], references: [id], onUpdate: Restrict, map: "pengukuran_frekuensi_data_isr_id_foreign")
  locations                  locations?          @relation(fields: [location_id], references: [id], onUpdate: Restrict, map: "pengukuran_frekuensi_location_id_foreign")
  lokasi_pemancar            lokasi_pemancar?    @relation(fields: [lokasi_pemancar_id], references: [id], onUpdate: Restrict, map: "pengukuran_frekuensi_lokasi_pemancar_id_foreign")
  pengukuran_studio          pengukuran_studio?  @relation(fields: [pengukuran_studio_id], references: [id], onUpdate: Restrict, map: "pengukuran_frekuensi_pengukuran_studio_id_foreign")
  perangkat_pemancar         perangkat_pemancar? @relation(fields: [perangkat_pemancar_id], references: [id], onUpdate: Restrict, map: "pengukuran_frekuensi_perangkat_pemancar_id_foreign")
  stasiun_radio              stasiun_radio?      @relation(fields: [stasiun_radio_id], references: [id], onUpdate: Restrict, map: "pengukuran_frekuensi_stasiun_radio_id_foreign")

  @@index([data_isr_id], map: "pengukuran_frekuensi_data_isr_id_foreign")
  @@index([location_id], map: "pengukuran_frekuensi_location_id_foreign")
  @@index([lokasi_pemancar_id], map: "pengukuran_frekuensi_lokasi_pemancar_id_foreign")
  @@index([pengukuran_studio_id], map: "pengukuran_frekuensi_pengukuran_studio_id_foreign")
  @@index([perangkat_pemancar_id], map: "pengukuran_frekuensi_perangkat_pemancar_id_foreign")
  @@index([stasiun_radio_id], map: "pengukuran_frekuensi_stasiun_radio_id_foreign")
}

model pengukuran_studio {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  jenis_stl            String?                @db.VarChar(255)
  no_spt               String                 @db.VarChar(255)
  tgl_spt              DateTime               @db.Date
  jenis_sbk            String?                @db.VarChar(255)
  kecamatan            String?                @db.VarChar(255)
  jalan                String?                @db.VarChar(255)
  merk_alat_ukur       String?                @db.VarChar(255)
  tipe_alat_ukur       String?                @db.VarChar(255)
  created_at           DateTime?              @db.Timestamp(0)
  updated_at           DateTime?              @db.Timestamp(0)
  pengukuran           pengukuran[]
  pengukuran_frekuensi pengukuran_frekuensi[]
}

model perangkat_pemancar {
  id                         BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  merk                       String                 @db.VarChar(255)
  jenis_type                 String?                @db.VarChar(255)
  nomor_seri                 String?                @unique(map: "perangkat_pemancar_nomor_seri_unique") @db.VarChar(255)
  negara_pembuat             String?                @db.VarChar(255)
  tahun_pembuat              Int?
  frekuensi_mhz              Decimal?               @db.Decimal(8, 4)
  kelas_emisi                String?                @db.VarChar(255)
  bandwidth_khz              Decimal?               @db.Decimal(8, 4)
  kedalaman_modulasi_percent Int?
  max_power_dbm              Decimal?               @db.Decimal(8, 4)
  jenis_antena               String?                @db.VarChar(255)
  polarisasi                 String?                @db.VarChar(255)
  jumlah_elemen_bay          Int?
  gain_db                    Decimal?               @db.Decimal(8, 4)
  beam_arah                  String?                @db.VarChar(255)
  jenis_kabel_feeder         String?                @db.VarChar(255)
  tipe_kabel                 String?                @db.VarChar(255)
  panjang_kabel_m            Decimal?               @db.Decimal(8, 4)
  created_at                 DateTime?              @db.Timestamp(0)
  updated_at                 DateTime?              @db.Timestamp(0)
  pengukuran                 pengukuran[]
  pengukuran_frekuensi       pengukuran_frekuensi[]
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model stasiun_radio {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  nama_penyelenggara   String                 @db.VarChar(255)
  jenis_komunikasi     String?                @db.VarChar(255)
  alamat               String?                @db.VarChar(255)
  kelurahan            String?                @db.VarChar(255)
  kecamatan            String?                @db.VarChar(255)
  kota_madya           String?                @db.VarChar(255)
  telp_fax             String?                @db.VarChar(255)
  email                String?                @db.VarChar(255)
  location_id          BigInt?                @db.UnsignedBigInt
  created_at           DateTime?              @db.Timestamp(0)
  updated_at           DateTime?              @db.Timestamp(0)
  pengukuran           pengukuran[]
  pengukuran_frekuensi pengukuran_frekuensi[]
  locations            locations?             @relation(fields: [location_id], references: [id], onUpdate: Restrict, map: "stasiun_radio_location_id_foreign")

  @@index([location_id], map: "stasiun_radio_location_id_foreign")
}

model users {
  id                BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  username          String     @unique(map: "users_username_unique") @db.VarChar(255)
  name              String     @db.VarChar(255)
  email             String     @unique(map: "users_email_unique") @db.VarChar(255)
  email_verified_at DateTime?  @db.Timestamp(0)
  password          String     @db.VarChar(255)
  is_admin          Boolean    @default(false)
  role              users_role @default(viewers)
  remember_token    String?    @db.VarChar(100)
  created_at        DateTime?  @db.Timestamp(0)
  updated_at        DateTime?  @db.Timestamp(0)
  gangguan          gangguan[]
}

enum kabupaten_kab {
  Bandung
  Bogor
  Bekasi
  Depok
  Cimahi
  Tasikmalaya
  Cirebon
  Sukabumi
  Garut
  Sumedang
  Majalengka
  Subang
  Indramayu
  Purwakarta
  Karawang
  Cianjur
  Kuningan
  Pangandaran
  Banjar
  Bandung_Barat    @map("Bandung Barat")
  Ciamis
  Kota_Bandung     @map("Kota Bandung")
  Kota_Banjar      @map("Kota Banjar")
  Kota_Cimahi      @map("Kota Cimahi")
  Kota_Cirebon     @map("Kota Cirebon")
  Kota_Sukabumi    @map("Kota Sukabumi")
  Kota_Tasikmalaya @map("Kota Tasikmalaya")
}

enum gangguan_severity {
  marabahaya
  non_marabahaya @map("non marabahaya")
}

enum users_role {
  admin
  viewers
}

enum gangguan_band_frekuensi {
  HF
  VHF
  UHF
  SHF
  FM
}

enum gangguan_service {
  Aeronautical
  Broadcast
  Fixed_Service         @map("Fixed Service")
  Land_Mobile__private_ @map("Land Mobile (private)")
  Land_Mobile__public_  @map("Land Mobile (public)")
  Maritime
  Satellite
  Other_Services        @map("Other Services")
}

enum gangguan_status {
  pending
  in_progress @map("in progress")
  resolved
  rejected
  on_hold     @map("on hold")
}

model audit_logs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt?  @db.UnsignedBigInt
  action     String   @db.VarChar(255)
  details    String   @db.Text
  created_at DateTime @default(now()) @db.Timestamp(0)
}
